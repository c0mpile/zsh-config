#!/usr/bin/env zsh

zconf compile -- $ZCONF/zconf/{main.zsh,sc/exec-zsh-i,fn/(|-|_)zconf[^.]#~*.zwc} $ZCONF/zconf.zsh || return

[[ -v functions[compinit] ]] && unfunction compinit
autoload -Uz +X compinit || return
local orig="bindkey '^i' | IFS=\$' \t' read -A _i_line"
local replacement="_i_line=( '\"^I\"' zconf-fzf-complete )"
print -r -- ${functions[compinit]/$orig/$replacement} >$ZCONF/zconf/fn/tmp.$$.compinit || return
zf_mv -- $ZCONF/zconf/fn/tmp.$$.compinit $ZCONF/zconf/fn/-zconf-compinit-impl || return
zconf compile -- $ZCONF/zconf/fn/-zconf-compinit-impl || return
autoload -Uz -- -zconf-compinit-impl

function compinit() {}
