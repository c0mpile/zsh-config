#!/usr/bin/env zsh

eval "$_zconf_opt"

if [[ -e $ZCONF/.updating ]]; then
  print -ru2 -- ${(%):-"%F{3}zconf%f: updating %Bfzf%b binary"}
else
  print -ru2 -- ${(%):-"%F{3}zconf%f: fetching %Bfzf%b binary"}
fi

local uname_sm
[[ ! -v commands[uname] ]] || uname_sm=$(uname -sm) || return

local -i installed

case $uname_sm in
  'Linux i686')
    local v=0.22.0
    local url=https://github.com/junegunn/fzf-bin/releases/download/$v/fzf-$v-linux_386.tgz
  ;;
  *)
    local BASH_SOURCE=($ZCONF_PACKAGE_DIR/install) err
    if ! err=$(local opt && emulate sh && set -- --bin &&
                  builtin source "${BASH_SOURCE[0]}" 2>&1); then
      print -ru2 -- $err
      return 1
    fi
    installed=1
  ;;
esac

if (( ! installed )); then
  local err archive=$ZCONF_PACKAGE_DIR/fzf.tar.gz
  if (( $+commands[curl] )); then
    err="$(command curl -fsSL -- $url 2>&1 >$archive)"
  elif (( $+commands[wget] )); then
    err="$(command wget -O-   -- $url 2>&1 >$archive)"
  else
    print -Pru2 -- "%F{3}zconf%f: please install %F{1}curl%f or %F{1}wget%f"
    return 1
  fi
  if (( $? )); then
    print -ru2 -- $err
    print -Pru2 -- "%F{3}zconf%f: failed to download %F{1}${url//\%/%%}%f"
    return 1
  fi
  [[ -e $ZCONF_PACKAGE_DIR/bin ]] || zf_mkdir -- $ZCONF_PACKAGE_DIR/bin || return
  command tar -C $ZCONF_PACKAGE_DIR/bin -xzf $archive || return
  zf_rm -- $archive || return
fi

if [[ -h $ZCONF_PACKAGE_DIR/bin/fzf ]]; then
  command cp -- $ZCONF_PACKAGE_DIR/bin/fzf $ZCONF_PACKAGE_DIR/bin/fzf.tmp || return
  zf_mv -f -- $ZCONF_PACKAGE_DIR/bin/fzf.tmp $ZCONF_PACKAGE_DIR/bin/fzf   || return
fi
